# ── CrowdCent ────────────────────────────────────────────────────────────────
# crowdcent.com -> profile -> "Generate New Key"
CROWDCENT_API_KEY=
SUBMIT=0                 # 1 = also upload the ranking to CrowdCent each run
SUBMIT_SLOT=1            # slot 1-5

# ── AlgoChains (signals to subscribers) ──────────────────────────────────────
# Developer -> keys on algochains.ai. BOT_NAME must match the marketplace listing.
ALGOCHAINS_API_KEY=
BOT_NAME=CrowdCent-Model-Roo
SIGNAL_URL=https://signals-prod.algochains.ai/signals/signal/
SEND_SIGNALS=0           # 1 = actually POST the rebalance signals (0 = print them)

# ── Alpaca (owner's own account; paper keys start with PK) ───────────────────
# Used to (a) filter the top-40 to pairs Alpaca can trade, (b) optionally mirror the trades.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
EXECUTE_DIRECT=0         # 1 = also place the same orders on this Alpaca account

# ── portfolio ────────────────────────────────────────────────────────────────
TOP_N=40                 # number of longs
RANK_HORIZON=pred_10d    # rank by the 10-day prediction (matches the 10-day rerun)
PORTFOLIO_USD=50000      # fixed base: always allocate INVEST_PCT of this (auto = live account equity)
INVEST_PCT=0.90          # 90% invested
WEIGHTING=log            # log = size decays with rank (#1 biggest, last smallest); equal = flat split
MIN_NOTIONAL_USD=10      # drop names whose slice would be smaller than this

# ── schedule ─────────────────────────────────────────────────────────────────
RUN_EVERY_DAYS=10
RUN_AT_UTC=15:00         # inside CrowdCent's 14:00-18:00 UTC window
RUN_ON_START=0           # 1 = run immediately on first start

# ── welcome watcher ──────────────────────────────────────────────────────────
# New subscribers are put into the main portfolio's current positions, scaled to this account size.
REGISTRY_DB_URL=            # credential_reader DSN (same as Roobertos bot)
WELCOME_MODE=exact         # exact = copy the main account's quantities 1:1 ($50k paper minimum); scaled = scale to WELCOME_ACCOUNT_USD
WELCOME_ACCOUNT_USD=50000
WATCH_POLL_SECONDS=60
HORIZONS=10d              # train/evaluate only the 10-day target (10d,30d = both)
